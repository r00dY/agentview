{
  "name": "@agentview/api",
  "version": "0.1.13",
  "type": "module",
  "scripts": {
    "dev:http": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:proxy": "go run src/proxy/main.go",
    "dev:streaming": "tsx watch src/streaming/streaming-server.ts",
    "log:errors": "cat logs/api.log| jq 'select(.level >= 50)'",
    "log:slow": "cat logs/api.log| jq 'select(.duration > 50 and (.path | startswith(\"/api/auth\") | not))'",
    "log:runs": "tsx src/scripts/log-expired.ts",
    "log:patchtime": "cat logs/api.log | jq -s '[.[] | select(.patchtime) | .patchtime] | add / length'",
    "dev": "concurrently \"npm run dev:http\" \"npm run dev:worker\" \"npm run dev:proxy\" \"npm run dev:streaming\"",
    "http": "tsx src/index.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc --noEmit && tsc",
    "db:clear": "tsx scripts/db-clear.ts",
    "db:test": "tsx scripts/db-test.ts",
    "boss:dashboard": "pg-boss-dashboard",
    "test": "vitest"
  },
  "dependencies": {
    "@agentview/utils": "workspace:*",
    "@ai-sdk/openai": "^3.0.26",
    "@hono/node-server": "^1.19.0",
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.1.5",
    "@pg-boss/dashboard": "^1.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "agentview": "workspace:*",
    "ai": "6.0.158",
    "better-auth": "^1.2.12",
    "cheerio": "^1.2.0",
    "dotenv": "^17.1.0",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.2",
    "drizzle-zod": "^0.8.3",
    "eventsource-parser": "^3.0.6",
    "googleapis": "^171.4.0",
    "hono": "^4.9.4",
    "ioredis": "^5.10.0",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.2",
    "marked": "^16.4.2",
    "openai": "^6.7.0",
    "pg": "^8.16.3",
    "pg-boss": "^12.18.2",
    "pino": "^10.3.1",
    "planer": "^1.2.0",
    "resend": "^6.6.0",
    "tsx": "^4.7.1",
    "zod": "^4.1.3"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20.11.17",
    "@types/pg": "^8.15.5",
    "@vitest/coverage-v8": "^4.0.7",
    "concurrently": "^9.2.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.8.3",
    "vitest": "^4.0.7"
  },
  "license": "AGPL-3.0"
}
