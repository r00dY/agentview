{
  "name": "@agentview/monorepo",
  "private": true,
  "version": "0.1.13",
  "scripts": {
    "release": "node ./scripts/release/index.mjs",
    "release:build": "node ./scripts/release/build.mjs",
    "release:version": "node ./scripts/release/version.mjs",
    "release:publish": "node ./scripts/release/publish.mjs",
    "db:clear": "pnpm --filter ./apps/api db:clear",
    "db:generate": "pnpm --filter ./apps/api drizzle-kit generate",
    "dev:api": "pnpm --filter ./apps/api dev",
    "dev:api:http": "pnpm --filter ./apps/api dev:http",
    "dev:api:worker": "pnpm --filter ./apps/api dev:worker",
    "dev:api:streaming": "pnpm --filter ./apps/api dev:streaming",
    "dev:proxy": "pnpm --filter ./apps/proxy dev",
    "dev:webapp": "pnpm --filter ./apps/webapp dev",
    "dev:docs": "pnpm --filter ./apps/docs dev --no-open",
    "dev:ngrok": "ngrok http 1990 --log stdout",
    "dev:drizzle-studio": "(cd apps/api && npx drizzle-kit studio)",
    "prod:drizzle-studio": "(cd apps/api && DATABASE_URL=\"$PRODUCTION_DATABASE_URL?sslmode=require\" npx drizzle-kit studio --port 4984)",
    "dev": "concurrently --colors -n api-http,api-worker,api-streaming,proxy,webapp,drizzle,ngrok -c blue,green,yellow,gray,magenta,cyan,white \"pnpm run dev:api:http\" \"pnpm run dev:api:worker\" \"pnpm run dev:api:streaming\" \"pnpm run dev:proxy\" \"pnpm run dev:webapp\" \"pnpm run dev:drizzle-studio\" \"pnpm run dev:ngrok\"",
    "seed-users": "pnpm --filter ./apps/tests seed-users",
    "sync-openapi": "./scripts/sync-openapi.sh",
    "kill-ports": "./scripts/kill-ports.sh"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
